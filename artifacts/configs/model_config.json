{
  "random_state": 42,
  "cross_validation": {
    "strategy": "GroupKFold",
    "n_splits": 5,
    "group_column": "trip_id"
  },
  "models": {
    "Logistic Regression": {
      "max_iter": 1000
    },
    "KNN": {
      "n_neighbors": 5,
      "weights": "distance"
    },
    "Random Forest": {
      "n_estimators": 200,
      "n_jobs": -1
    },
    "Extra Trees": {
      "n_estimators": 200,
      "n_jobs": -1
    },
    "HistGradientBoosting": {
      "max_iter": 100,
      "learning_rate": 0.1
    }
  },
  "metrics": [
    "accuracy",
    "precision_macro",
    "recall_macro",
    "f1_macro",
    "log_loss",
    "training_time_sec",
    "inference_time_sec"
  ]
}
